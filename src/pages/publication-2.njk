---
layout: layouts/base.njk
title: "Publication #2"
permalink: /publication-2/
pageId: publication
pageCss: publication
pubKey: publication-2
---
{% set pub = publications[pubKey] %}
<section class="band band--grey pub">
  <div class="pub__pages">
    {% for img in pub.images %}<img src="{{ img | url }}" alt="{{ pub.title }} page {{ loop.index }}" width="{{ pub.width }}" loading="{{ 'eager' if loop.first else 'lazy' }}">{% endfor %}
    <div class="pub__back"><a class="pill pill--navy" href="{{ '/about' | url }}">Back</a></div>
  </div>
</section>
