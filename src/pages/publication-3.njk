---
layout: layouts/base.njk
title: "publication #3"
permalink: /publication-3/
pageId: publication
pageCss: publication
pubKey: publication-3
---
{% set pub = publications[pubKey] %}
<section class="pub pub--3">
  <div class="pub__pages">
    {% for img in pub.images %}<img src="{{ img | url }}" alt="{{ pub.title }} page {{ loop.index }}" width="{{ pub.width }}" loading="{{ 'eager' if loop.first else 'lazy' }}">{% endfor %}
    <div class="pub__back"><a class="btn pub__btn" href="{{ '/about' | url }}">Back</a></div>
  </div>
</section>
