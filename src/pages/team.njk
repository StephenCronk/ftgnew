---
layout: layouts/base.njk
title: Our Team
permalink: /home/meet-our-team/
pageId: team
pageCss: about
---
<section class="page-hero page-hero--plain" aria-labelledby="team-title">
  <div class="page-hero__inner"><h1 class="page-hero__title" id="team-title">Our team</h1></div>
</section>

<section class="band band--grey team">
  <div class="container">
    <img class="team__collage" src="{{ '/assets/img/collage-ftg-2-e1689937937420.webp' | url }}" alt="" loading="lazy" data-reveal>
  </div>
</section>

<section class="band band--light board" aria-labelledby="board-title">
  <div class="container">
    <header class="band__head" data-reveal><h2 class="band__title" id="board-title">Our Board</h2></header>
    {% set items = widgets['team:34e2e72'].items %}{% set prefix = 'board' %}{% include "partials/adv-accordion.njk" %}
  </div>
</section>

<section class="band band--grey volunteers-grid" aria-labelledby="vol-title">
  <div class="container">
    <header class="band__head" data-reveal><h2 class="band__title" id="vol-title">Our Volunteers</h2></header>
    {% set items = widgets['team:1bf2a23'].items %}{% set variant = 'logo' %}{% set scroll = 1 %}{% include "partials/carousel.njk" %}
  </div>
</section>
