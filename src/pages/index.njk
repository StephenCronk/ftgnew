      {%- endfor %}
    </div>
  </div>
</section>

<section class="promo-band">
  <div class="container">
    <a class="promo" href="{{ '/publication-2/' | url }}" data-reveal>
      <img class="promo__bg" src="{{ '/assets/img/Gemini_Generated_Image_c36g3pc36g3pc36g-scaled.webp' | url }}" alt="" loading="lazy">
