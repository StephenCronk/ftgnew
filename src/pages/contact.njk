<section class="page-hero page-hero--contact" aria-labelledby="contact-title">
  <div class="page-hero__inner">
    <h1 class="page-hero__title" id="contact-title">Contact us</h1>
    <div class="page-hero__actions pills rise" style="--d:180ms">
      <a class="pill pill--cyan" href="#forpatientsvolunteers">Patients &amp; volunteers</a>
      <a class="pill pill--ghost" href="#donors">Donors &amp; sponsors</a>
    </div>
  </div>
</section>

<div class="anchor" id="patients"></div>
<section class="band band--light" id="forpatientsvolunteers" aria-labelledby="pv-title">
  <div class="container">
    <header class="band__head" data-reveal><h2 class="band__title" id="pv-title">For Patients or Volunteers</h2></header>
    <div class="cards cards--2 contact-who">
      <div class="copy card" data-reveal>
        <h3>Patients</h3>
        <p>Please send us an email to begin the screening process. Messages are returned during clinic hours <strong>only</strong>. All patients must be approved before any appointments are scheduled.</p>
      </div>
      <div class="copy card" data-reveal>
        <h3>Volunteers</h3>
        <p>Please send us an email at your preferred location (Scarborough or Rexdale) noting your availability, or to the General Inquiries address for any questions.</p>
        <p class="note">*Email only outside clinic hours.</p>
      </div>
    </div>
    <div class="cards contact-places">
      <article class="card" data-reveal>
        <h3 class="card__title">Scarborough, ON</h3>
        <a class="ibox" href="mailto:urbandental@ccrihc.org"><span class="ibox__icon">{% include "partials/icons/envelope.svg" %}</span><span>urbandental@ccrihc.org</span></a>
        <a class="ibox" href="tel:+14162894349"><span class="ibox__icon">{% include "partials/icons/phone.svg" %}</span><span>416-289-4349 (call and text)</span></a>
        <div class="ibox"><span class="ibox__icon">{% include "partials/icons/clock.svg" %}</span><span>Mon - Fri: 9 AM - 2 PM</span></div>
      </article>
      <article class="card" data-reveal>
        <h3 class="card__title">Rexdale, ON</h3>
        <a class="ibox" href="mailto:rexdale@fillingthegap.ca"><span class="ibox__icon">{% include "partials/icons/envelope.svg" %}</span><span>rexdale@fillingthegap.ca (email only)</span></a>
        <a class="ibox" href="tel:+14167484689"><span class="ibox__icon">{% include "partials/icons/phone.svg" %}</span><span>416-748-4689</span></a>
        <div class="ibox"><span class="ibox__icon">{% include "partials/icons/clock.svg" %}</span><span>Tues, Thurs: 4 - 8 PM<br>Sat: 9 AM - 1 PM</span></div>
      </article>
      <article class="card" data-reveal>
        <h3 class="card__title">General Inquiries</h3>
        <a class="ibox" href="mailto:info@fillingthegap.ca"><span class="ibox__icon">{% include "partials/icons/envelope.svg" %}</span><span>info@fillingthegap.ca</span></a>
      </article>
    </div>
    <div class="contact-maps" data-reveal>
      <iframe title="Map: 4158 Sheppard Ave E" loading="lazy" src="https://maps.google.com/maps?q=4158%20Sheppard%20Ave%20E&amp;t=m&amp;z=15&amp;output=embed&amp;iwloc=near" referrerpolicy="no-referrer-when-downgrade"></iframe>
      <iframe title="Map: 21 Panorama Court, Toronto" loading="lazy" src="https://maps.google.com/maps?q=21%20Panorama%20Court%2C%20Toronto%2C%20ON%20M9V%204E3&amp;t=m&amp;z=15&amp;output=embed&amp;iwloc=near" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>

<div class="anchor" id="donors"></div>
<section class="band band--grey" aria-labelledby="donors-title">
  <div class="container">
    <header class="band__head" data-reveal><h2 class="band__title" id="donors-title">For Donors or Sponsors</h2></header>
    <div class="split split--wide-text">
      <div class="copy" data-reveal>
        <h3>Interested in Donating?</h3>
        <p>All donations go towards providing affordable dental care in the Greater Toronto Area to those in need. If you have any questions on how you can donate, become a sponsor, or the process, please contact us by email. Charitable receipts can be provided upon request for donations above $20.</p>
      </div>
      <div class="card" data-reveal>
        <h3 class="card__title">Talk To Us</h3>
        <a class="ibox ibox--bold" href="mailto:info@fillingthegap.ca"><span class="ibox__icon">{% include "partials/icons/envelope.svg" %}</span><span>info@fillingthegap.ca</span></a>
        <h3 class="card__title donate__pp">We're on PayPal</h3>
        <form class="paypal" action="https://www.paypal.com/cgi-bin/webscr" method="post" target="_blank">
          <input type="hidden" name="business" value="info@fillingthegap.ca">
          <input type="hidden" name="cmd" value="_donations">
          <input type="hidden" name="currency_code" value="CAD">
          <input type="hidden" name="item_name" value="Filling the Gap Dental Outreach">
          <button type="submit" class="paypal__btn" aria-label="Donate with PayPal"><svg viewBox="0 0 140 36" width="140" height="36" aria-hidden="true"><defs><linearGradient id="ppg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffd25c"/><stop offset="1" stop-color="#f7a814"/></linearGradient></defs><rect x=".5" y=".5" width="139" height="35" rx="5" fill="url(#ppg)" stroke="#d29c22"/><text x="12" y="23" font-family="Arial, sans-serif" font-size="13" fill="#1b2b4a">Donate with</text><text x="86" y="24" font-family="Verdana, Arial, sans-serif" font-size="16" font-style="italic" font-weight="700" fill="#003087">Pay</text><text x="111" y="24" font-family="Verdana, Arial, sans-serif" font-size="16" font-style="italic" font-weight="700" fill="#009cde">Pal</text></svg></button>
        </form>
      </div>
    </div>
  </div>
</section>

