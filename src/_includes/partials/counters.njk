{#- expects items [{n,label,prefix?}] -#}
<div class="counters">
{% for c in items %}
  <div class="counter">
    <div class="counter__n">{{ c.prefix }}<span data-count="{{ c.n }}">{{ c.n | int | localeNumber }}</span></div>
    <p class="counter__label">{{ c.label }}</p>
  </div>
{% endfor %}
</div>
