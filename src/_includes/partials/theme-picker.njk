<div class="theme-picker" data-theme-picker>
  <div class="theme-picker__panel" id="theme-picker-panel" role="group" aria-labelledby="theme-picker-title" hidden>
    <p class="theme-picker__title" id="theme-picker-title">Preview a theme</p>
    <ul class="theme-picker__list">
      {%- for t in themes %}
      <li><button class="theme-picker__option" type="button" data-theme-option="{{ t.id }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">
        <span class="theme-picker__swatch" aria-hidden="true">{% for c in t.swatch %}<span style="background:{{ c }}"></span>{% endfor %}</span>
        <span><span class="theme-picker__name">{{ t.name }}</span><span class="theme-picker__note">{{ t.note }}</span></span>
      </button></li>
      {%- endfor %}
    </ul>
  </div>
  <button class="theme-picker__tab" type="button" aria-expanded="false" aria-controls="theme-picker-panel" aria-label="Theme picker">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 0 0 0 18c1.1 0 1.8-.8 1.8-1.8 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-1 .8-1.8 1.8-1.8h2.1A4.3 4.3 0 0 0 21 10.7C21 6.4 17 3 12 3zm-5.5 9a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm3-4a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm3 4a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/></svg>
  </button>
</div>
