<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__logo" href="{{ '/' | url }}" rel="home">
      <img src="{{ '/assets/img/FTGLogo_white_may20-scaled.webp' | url }}" width="200" height="66" alt="{{ site.name }}">
    </a>
    <button class="site-header__toggle" type="button" aria-controls="primary-nav" aria-expanded="false">
      <span class="visually-hidden">Main Menu</span>
      <svg class="icon-menu" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z"/></svg>
      <svg class="icon-close" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M18.3 5.71 12 12l6.3 6.29-1.41 1.42L10.59 13.4 4.3 19.71 2.89 18.3 9.17 12 2.89 5.71 4.3 4.29l6.29 6.3 6.3-6.3z"/></svg>
    </button>
    <nav class="site-nav" id="primary-nav" aria-label="Site Navigation">
      <ul class="site-nav__menu">
        {% for item in nav.header %}
        <li class="site-nav__item{% if item.href == page.url %} is-current{% endif %}">
          <a class="site-nav__link" href="{{ item.href | url }}"{% if item.href == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
        </li>
        {% endfor %}
      </ul>
      <a class="btn-donate" href="{{ nav.donate.href | url }}">{{ nav.donate.label }}</a>
    </nav>
  </div>
</header>
