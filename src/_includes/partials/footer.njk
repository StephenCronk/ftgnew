<footer class="site-footer">
  <div class="site-footer__strip"></div>
  <div class="site-footer__inner">
    <nav class="footer-col footer-nav" aria-label="Footer Navigation">
      <h2 class="footer-col__title">Quick Links</h2>
      <ul>
        {% for item in nav.footer %}
        <li><a href="{{ item.href | url }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    {% for loc in locations %}
    <div class="footer-col footer-location">
      <h2 class="footer-col__title">{{ loc.name }}</h2>
      <ul class="footer-info">
        <li>
          <svg class="footer-info__icon" viewBox="0 0 384 512" aria-hidden="true"><path fill="currentColor" d="M172.3 501.7C27 291 0 269.4 0 192 0 86 86 0 192 0s192 86 192 192c0 77.4-27 99-172.3 309.7a24 24 0 0 1-39.4 0zM192 272a80 80 0 1 0 0-160 80 80 0 0 0 0 160z"/></svg>
          <span class="visually-hidden">Address: </span><span>{{ loc.address }}</span>
        </li>
        <li>
          <svg class="footer-info__icon" viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M464 64H48C21.5 64 0 85.5 0 112v288c0 26.5 21.5 48 48 48h416c26.5 0 48-21.5 48-48V112c0-26.5-21.5-48-48-48zm0 48v40.8c-22.4 18.3-58.2 46.7-134.6 106.5-16.8 13.2-50.2 45.1-73.4 44.7-23.2.4-56.6-31.5-73.4-44.7C106.2 199.5 70.4 171.1 48 152.8V112h416zM48 400V214.4c22.9 18.3 55.4 43.9 104.9 82.6 21.9 17.2 60.1 55.2 103.1 55 42.7.2 80.5-37.2 103.1-55 49.5-38.8 82-64.4 104.9-82.6V400H48z"/></svg>
          <span class="visually-hidden">Email: </span><a href="mailto:{{ loc.email }}">{{ loc.email }}</a>
        </li>
        <li>
          <svg class="footer-info__icon" viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M497.4 361.8l-112-48a24 24 0 0 0-28 6.9l-49.6 60.6A370.7 370.7 0 0 1 130.6 204.1l60.6-49.6a23.9 23.9 0 0 0 6.9-28l-48-112A24.2 24.2 0 0 0 122.6.6l-104 24A24 24 0 0 0 0 48c0 256.5 207.9 464 464 464a24 24 0 0 0 23.4-18.6l24-104a24.3 24.3 0 0 0-14-27.6z"/></svg>
          <span class="visually-hidden">Phone: </span><a class="footer-info__strong" href="tel:+1{{ loc.phone | replace('-', '') }}">{{ loc.phone }}</a>
        </li>
        <li>
          <svg class="footer-info__icon" viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8zm0 448c-110.5 0-200-89.5-200-200S145.5 56 256 56s200 89.5 200 200-89.5 200-200 200zm61.8-104.4l-84.9-61.7a12 12 0 0 1-4.9-9.7V116c0-6.6 5.4-12 12-12h32c6.6 0 12 5.4 12 12v141.7l66.8 48.6a12 12 0 0 1 2.6 16.8l-18.8 25.9a12.1 12.1 0 0 1-16.8 2.6z"/></svg>
          <span class="visually-hidden">Hours: </span><span class="footer-info__strong">{% for h in loc.hours %}{{ h }}{% if not loop.last %}<br>{% endif %}{% endfor %}</span>
        </li>
      </ul>
    </div>
    {% endfor %}
  </div>
  <div class="site-footer__legal">
    <p>Canadian Charitable Registration #{{ site.charityNumber }}</p>
    <p>Copyright &copy; {{ site.copyrightYear }} {{ site.name }}</p>
  </div>
</footer>
