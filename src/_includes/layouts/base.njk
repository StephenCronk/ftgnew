<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% if noindex %}<meta name="robots" content="noindex, nofollow">
{% endif %}{% set pageTitle = fullTitle or (title + ' - ' + site.name) %}<title>{{ pageTitle | safe }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="en_CA">
<meta property="og:title" content="{{ pageTitle | safe }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/img/share-card.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site.name }} logo over a photo of two dentists">
<meta name="twitter:card" content="summary_large_image">
{% if schema %}<script type="application/ld+json">{{ organization | dump | safe }}</script>
{% endif %}<link rel="icon" href="{{ '/assets/img/favicon-32.png' | url }}" sizes="32x32" type="image/png">
<link rel="icon" href="{{ '/assets/img/favicon-192.png' | url }}" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="{{ '/assets/img/apple-touch-icon.png' | url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Arvo:ital,wght@0,400;0,700;1,400&family=Quicksand:wght@400;500;600;700&family=Roboto:wght@400;700&display=swap">
<link rel="stylesheet" href="{{ '/css/tokens.css' | url }}">
<link rel="stylesheet" href="{{ '/css/base.css' | url }}">
<link rel="stylesheet" href="{{ '/css/header.css' | url }}">
<link rel="stylesheet" href="{{ '/css/footer.css' | url }}">
<link rel="stylesheet" href="{{ '/css/components.css' | url }}">
{% if pageCss %}<link rel="stylesheet" href="{{ ('/css/pages/' + pageCss + '.css') | url }}">{% endif %}
{% if themePicker %}<link rel="stylesheet" href="{{ '/css/themes.css' | url }}">
<script>
window.ftgApplyTheme = function (id) {
  var themes = {{ themes | dump | safe }}, t = null, el = document.documentElement, link = document.getElementById('theme-fonts');
  for (var i = 1; i < themes.length; i++) if (themes[i].id === id) t = themes[i];
  if (!t) { el.removeAttribute('data-theme'); if (link) link.remove(); return; }
  el.setAttribute('data-theme', t.id);
  if (!link) { link = document.createElement('link'); link.rel = 'stylesheet'; link.id = 'theme-fonts'; document.head.appendChild(link); }
  link.href = t.fonts;
};
try { var saved = localStorage.getItem('ftg-theme'); if (saved) window.ftgApplyTheme(saved); } catch (e) {}
</script>
{% endif %}</head>
<body class="page-{{ pageId or 'default' }}">
<a class="skip-link" href="#content">Skip to content</a>
{% include "partials/header.njk" %}
<main id="content">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
{% include "partials/cookie.njk" %}
{% if themePicker %}{% include "partials/theme-picker.njk" %}{% endif %}
<script src="{{ '/js/main.js' | url }}" defer></script>
<script src="{{ '/js/components.js' | url }}" defer></script>
{% if pageJs %}<script src="{{ ('/js/pages/' + pageJs + '.js') | url }}" defer></script>{% endif %}
{% if themePicker %}<script src="{{ '/js/theme-picker.js' | url }}" defer></script>{% endif %}
</body>
</html>
